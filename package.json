{
  "name": "krishichain",
  "version": "0.1.0",
  "private": true,
  "description": "Low-cost IoT blockchain nodes for farm-to-fork traceability",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n chain,gateway,web -c blue,green,magenta \"npm:chain\" \"npm:dev:gateway\" \"npm:dev:web\"",
    "chain": "npm run chain -w contracts",
    "dev:gateway": "npm run dev -w @krishichain/gateway",
    "dev:web": "npm run dev -w @krishichain/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy:local": "npm run deploy:local -w contracts",
    "deploy:amoy": "npm run deploy:amoy -w contracts",
    "gen:vectors": "tsx scripts/gen-vectors.ts",
    "sim": "tsx scripts/sim-node.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e": "tsx scripts/e2e-demo.ts",
    "device:register": "tsx scripts/register-device.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
