# Copy to .env and fill in. NEVER commit .env.

# ---- Local chain (Hardhat node) ----
LOCAL_RPC_URL=http://127.0.0.1:8545
# Hardhat's first well-known dev account. Local chain ONLY — never fund this on a real network.
LOCAL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# A Polygon Amoy public mirror was built and deliberately dropped — the demo is local-only
# (TEAM-PLAN.md §6, cut item 5; the local chain was always the demo path per invariant 6).
# No AMOY_* variables here on purpose: don't resurrect them piecemeal. If the team decides
# to revisit a public mirror later, the working implementation is in git history.

# ---- Gateway ----
GATEWAY_PORT=8080
GATEWAY_DB_PATH=./data/krishichain.db
# Batch closes at whichever comes first (PROTOCOL.md §4)
BATCH_MAX_LEAVES=256
BATCH_MAX_SECONDS=60

# Which deployments/<network>/addresses.json the gateway anchors against.
ANCHOR_NETWORK=localhost
# High-water mark for the anchor service. Delete it only if you also reset the chain —
# it is what stops a resumed gateway from anchoring the same batch twice (S1-09).
ANCHOR_STATE_PATH=./data/anchor-state.json

# ---- MQTT (S1-15) ----
# `npm run broker` serves both. The browser dashboard needs the WS one; a browser
# cannot open a raw TCP socket.
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_WS_URL=ws://127.0.0.1:9001

# ---- Cold-chain rules (PRD §6.4) ----
TEMP_MAX_C=10
TEMP_BREACH_MINUTES=15
TEMP_MIN_C=0
# How long a LONE device must stay out of range before it alone is a breach. The demo
# value; TEMP_BREACH_MINUTES above is the production one. The cold-box rig lands a
# breach in 60-120 s (H2-07), so fifteen minutes would never fire on stage.
TEMP_BREACH_SECONDS=30
# Window in which different signal classes from different devices corroborate each
# other into a 2-of-3 consensus breach (S1-14).
CONSENSUS_WINDOW_SECONDS=60

# ---- Web ----
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
# The browser reads anchor roots straight from this RPC — never through our API (PRD §6.6).
# Points at the local chain: it is a DIFFERENT PROCESS from the gateway (8545 vs 8080), so
# the trust property — verification independent of the server that served the data — still
# holds even though both processes happen to run on this laptop.
NEXT_PUBLIC_VERIFY_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_VERIFY_CHAIN_ID=31337
